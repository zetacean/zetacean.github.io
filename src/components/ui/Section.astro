---
interface Props {
  id: string;
  title: string;
  /** Tighter vertical spacing for sections with little content. */
  compact?: boolean;
}

const { id, title, compact = false } = Astro.props;
---

<section
  {id}
  class:list={['section', { 'section--compact': compact }]}
  aria-labelledby={`${id}-title`}
>
  <div class="container">
    <h2 id={`${id}-title`} class="section__title" data-reveal>
      {title}
    </h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-24);
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }

  .section--compact {
    padding-block: var(--space-16) var(--space-24);
  }

  .section--compact .section__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .section__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-12);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .section__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--color-accent-strong),
      var(--color-border-strong) 40%,
      transparent
    );
    transform-origin: left;
    transition: transform 1100ms var(--ease) 200ms;
  }

  /* Title rule draws itself when the heading scrolls into view. */
  :global(.js) .section__title:not(:global(.is-visible))::after {
    transform: scaleX(0);
  }
</style>
