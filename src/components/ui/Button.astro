---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;
---

<a
  {href}
  class:list={['btn', `btn--${variant}`]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span class="btn__label">
    <slot />
  </span>
  <span class="btn__arrow" aria-hidden="true">
    →
  </span>
</a>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--duration) var(--ease),
      box-shadow 300ms var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .btn__arrow {
    display: inline-block;
    width: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      width 250ms var(--ease),
      margin-left 250ms var(--ease),
      opacity 250ms var(--ease),
      transform 250ms var(--ease);
  }

  .btn:hover .btn__arrow,
  .btn:focus-visible .btn__arrow {
    width: 1em;
    margin-left: var(--space-2);
    opacity: 1;
    transform: none;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0) scale(0.98);
  }

  /* Primary: animated gradient + light sweep + glow */
  .btn--primary {
    color: var(--color-on-accent);
    background: linear-gradient(
      110deg,
      var(--palette-magenta),
      var(--palette-rose) 50%,
      var(--palette-magenta)
    );
    background-size: 200% 100%;
    background-position: 0 0;
    transition-property: transform, box-shadow, background-position;
    transition-duration: var(--duration), 300ms, 500ms;
  }

  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(255 255 255 / 0.28) 50%,
      transparent 65%
    );
    transform: translateX(-120%);
  }

  .btn--primary:hover {
    background-position: 100% 0;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--palette-rose) 38%, transparent);
  }

  .btn--primary:hover::before {
    transform: translateX(120%);
    transition: transform 700ms var(--ease);
  }

  /* Ghost: border glow + soft fill */
  .btn--ghost {
    border-color: var(--color-border-strong);
    color: var(--color-text);
    background: transparent;
    transition-property: transform, box-shadow, border-color, color, background-color;
    transition-duration: var(--duration), 300ms, var(--duration), var(--duration), 300ms;
  }

  .btn--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--palette-rose) 10%, transparent);
  }
</style>
