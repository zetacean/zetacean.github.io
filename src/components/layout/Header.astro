---
import type { Locale } from '@/types/profile';
import { useTranslations } from '@/i18n/ui';
import { sections, site } from '@/config/site';
import { localePath, otherLocale } from '@/utils/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);
const alt = otherLocale(locale);
---

<header class="header">
  <div class="container header__inner">
    <a href={home} class="header__brand">
      {site.nickname}
    </a>

    <button class="header__toggle" popovertarget="site-menu" aria-label={t.menu}>
      <span class="header__bars" aria-hidden="true"></span>
    </button>

    <nav id="site-menu" popover class="header__nav" aria-label="Principal">
      <ul>
        {sections.map((id) => (
          <li>
            <a href={`${home}#${id}`}>{t.nav[id]}</a>
          </li>
        ))}
      </ul>
      <a
        class="header__lang"
        href={localePath(alt)}
        hreflang={alt}
        lang={alt}
        aria-label={`${t.switchLanguage}: ${alt.toUpperCase()}`}
      >
        {alt.toUpperCase()}
      </a>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after picking a link.
  document.querySelectorAll<HTMLElement>('#site-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      const menu = document.getElementById('site-menu');
      if (menu?.matches(':popover-open')) menu.hidePopover();
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-h);
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-accent);
    transition:
      letter-spacing 300ms var(--ease),
      text-shadow 300ms var(--ease);
  }

  .header__brand:hover {
    letter-spacing: 0.1em;
    text-shadow: 0 0 18px color-mix(in srgb, var(--palette-rose) 55%, transparent);
  }

  .header__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .header__bars {
    position: relative;
  }

  .header__bars::before,
  .header__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__bars::before {
    top: -6px;
  }

  .header__bars::after {
    top: 6px;
  }

  /* Mobile: popover dropdown */
  .header__nav {
    inset: var(--header-h) 0 auto 0;
    margin: 0;
    width: 100%;
    padding: var(--space-6) var(--gutter);
    background: var(--color-bg-elevated);
    border: 0;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }

  .header__nav ul {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .header__nav li a {
    display: block;
    padding: var(--space-2) 0;
    text-decoration: none;
    font-size: var(--text-lg);
  }

  .header__lang {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .header__lang:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  @media (min-width: 52rem) {
    .header__toggle {
      display: none;
    }

    /* Desktop: inline nav; overrides the UA display:none of closed popovers */
    .header__nav,
    .header__nav:not(:popover-open) {
      display: flex;
      position: static;
      inset: auto;
      width: auto;
      padding: 0;
      align-items: center;
      gap: var(--space-8);
      background: none;
      border: 0;
      overflow: visible;
    }

    .header__nav ul {
      display: flex;
      gap: var(--space-6);
      margin: 0;
    }

    .header__nav li a {
      position: relative;
      padding: var(--space-1) 0;
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    /* Underline that grows from the left on hover/focus */
    .header__nav li a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--palette-magenta), var(--palette-rose));
      border-radius: 2px;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 300ms var(--ease);
    }

    .header__nav li a:hover,
    .header__nav li a:focus-visible {
      color: var(--color-text);
    }

    .header__nav li a:hover::after,
    .header__nav li a:focus-visible::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }
</style>
