---
import { Image } from 'astro:assets';
import avatar from '@/assets/profile.png';
import type { Locale, Profile } from '@/types/profile';
import { useTranslations } from '@/i18n/ui';
import Button from '@/components/ui/Button.astro';

interface Props {
  locale: Locale;
  profile: Profile;
}

const { locale, profile } = Astro.props;
const t = useTranslations(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__name">
        {profile.name}
      </h1>
      <p class="hero__role">{profile.role}</p>
      <p class="hero__tagline">{profile.tagline}</p>
      <div class="hero__actions">
        <Button href="#contact">{t.hero.cta}</Button>
        <Button href="#experience" variant="ghost">
          {t.hero.secondary}
        </Button>
      </div>
    </div>
    <div class="hero__photo">
      <div class="hero__photo-inner">
        <Image
          src={avatar}
          alt={t.hero.photoAlt}
          width={320}
          height={320}
          densities={[1, 1.5, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <ul class="hero__stats">
      {profile.highlights.map((h, i) => (
        <li data-reveal data-spotlight style={`--i:${i}`}>
          <strong data-count>{h.value}</strong>
          <span>{h.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 8vw, 9rem) var(--space-16);
  }

  /* Subtle "galaxy" backdrop: pure CSS, no images or JS. */
  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        40rem 26rem at 85% 0%,
        color-mix(in srgb, var(--palette-violet) 55%, transparent),
        transparent 70%
      ),
      radial-gradient(
        34rem 24rem at 0% 100%,
        color-mix(in srgb, var(--palette-navy) 90%, transparent),
        transparent 70%
      ),
      radial-gradient(
        18rem 14rem at 70% 90%,
        color-mix(in srgb, var(--palette-magenta) 28%, transparent),
        transparent 70%
      ),
      radial-gradient(1px 1px at 12% 20%, #fff8, transparent),
      radial-gradient(1px 1px at 28% 68%, #fff6, transparent),
      radial-gradient(1.5px 1.5px at 44% 12%, #ffffffaa, transparent),
      radial-gradient(1px 1px at 63% 44%, #fff7, transparent),
      radial-gradient(1.5px 1.5px at 78% 76%, #f4a6c4aa, transparent),
      radial-gradient(1px 1px at 91% 30%, #fff8, transparent),
      radial-gradient(1px 1px at 6% 82%, #fff6, transparent);
  }

  .hero__eyebrow {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .hero__name {
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .hero__role {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__tagline {
    margin-top: var(--space-6);
    max-width: 40rem;
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
  }

  /* Equal-size stat cards: one big figure + a short caption. */
  .hero__stats li {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    /* Reveal transition from global.css repeated so hover effects can be added. */
    transition:
      opacity 700ms var(--ease) calc(var(--i, 0) * 90ms),
      transform 700ms var(--ease) calc(var(--i, 0) * 90ms),
      translate 300ms var(--ease),
      border-color 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }

  .hero__stats li::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(
      14rem circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--palette-rose) 20%, transparent),
      transparent 70%
    );
    transition: opacity 300ms var(--ease);
  }

  /* Accent bar that grows on hover */
  .hero__stats li::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, var(--palette-magenta), var(--palette-rose));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease);
  }

  .hero__stats li:hover {
    translate: 0 -4px;
    border-color: var(--color-accent-strong);
    box-shadow: 0 16px 36px color-mix(in srgb, var(--palette-magenta) 20%, transparent);
  }

  .hero__stats li:hover::before {
    opacity: 1;
  }

  .hero__stats li:hover::after {
    transform: scaleX(1);
  }

  .hero__stats strong {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 2rem + 1.6vw, 3.25rem);
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .hero__stats span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-12);
  }

  .hero__photo {
    width: clamp(10rem, 40vw, 20rem);
    justify-self: start;
    grid-row: 1;
  }

  /* Portrait: rotating palette ring + soft glow, gentle float, lift on hover. */
  .hero__photo-inner {
    position: relative;
    isolation: isolate;
    animation: float 7s ease-in-out infinite;
    transition: scale 400ms var(--ease);
  }

  .hero__photo-inner:hover {
    scale: 1.04;
  }

  .hero__photo-inner::before,
  .hero__photo-inner::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--palette-rose),
      var(--palette-violet),
      var(--palette-navy),
      var(--palette-magenta),
      var(--palette-rose)
    );
    animation: spin 12s linear infinite;
    z-index: -1;
  }

  .hero__photo-inner::before {
    inset: -5px;
  }

  .hero__photo-inner::after {
    inset: -8%;
    filter: blur(34px);
    opacity: 0.35;
    transition: opacity 400ms var(--ease);
  }

  .hero__photo-inner:hover::after {
    opacity: 0.6;
  }

  .hero__photo-inner :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-bg);
  }

  @keyframes float {
    50% {
      translate: 0 -10px;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Name: slow light sweep across the gradient text. */
  .hero__name {
    background: linear-gradient(
      100deg,
      var(--color-text) 0%,
      var(--color-text) 35%,
      #f4a6c4 50%,
      var(--color-text) 65%,
      var(--color-text) 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      rise 700ms var(--ease) both,
      sheen 9s ease-in-out 1.2s infinite;
  }

  @keyframes sheen {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0 0;
    }
  }

  .hero__glow {
    animation: drift 20s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: scale(1.08) translate(-1.5%, 1.5%);
    }
  }

  .hero__stats {
    grid-column: 1 / -1;
  }

  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-16);
    }

    .hero__photo {
      grid-row: auto;
      justify-self: end;
    }
  }

  .hero__text > *:not(.hero__name),
  .hero__photo {
    animation: rise 700ms var(--ease) both;
  }

  .hero__text > :nth-child(2) {
    animation-delay: 60ms;
  }
  .hero__text > :nth-child(3) {
    animation-delay: 120ms;
  }
  .hero__text > :nth-child(4) {
    animation-delay: 180ms;
  }
  .hero__text > :nth-child(5) {
    animation-delay: 240ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
